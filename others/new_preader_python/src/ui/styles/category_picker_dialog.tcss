#category-picker-window {
    width: 70%;
    height: 80%;
    background: $background 85%;
    border: round $primary;
    padding: 1;
    layout: vertical;
}

#category-picker-title {
    width: 100%;
    height: 2;
    text-align: center;
    text-style: bold;
    color: $accent;
}

#category-picker-hint {
    width: 100%;
    height: 2;
    color: $text-muted;
}

#category-picker-options {
    width: 100%;
    height: 1fr;
    border: round $panel;
    background: $background;
    padding: 0 1;
    margin-bottom: 1;
}

#category-picker-options Checkbox {
    width: 100%;
    height: 2;
    margin: 0;
    padding: 0 1;
    border: none;
    background: $background;
}

#picker-custom-input {
    width: 100%;
    height: 3;
    margin-bottom: 1;
}

#category-picker-buttons {
    width: 100%;
    height: 3;
    align: center middle;
}

#category-picker-buttons Button {
    margin: 0 1;
    min-width: 10;
}
