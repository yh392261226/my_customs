#crawler-filter-window {
    width: 60%;
    height: 88%;
    background: $background 85%;
    border: round $primary;
    padding: 1;
    layout: vertical;
}

#crawler-filter-title {
    width: 100%;
    height: 2;
    text-align: center;
    text-style: bold;
    color: $accent;
}

#crawler-filter-desc {
    width: 100%;
    height: 2;
    color: $text-muted;
}

.crawler-filter-cat {
    width: 100%;
    height: 1;
    margin-top: 1;
    text-style: bold;
    color: $accent;
}

#crawler-filter-categories {
    width: 100%;
    height: 6;
    border: round $panel;
    background: $background;
    padding: 0 1;
}

#crawler-filter-categories Checkbox {
    width: 100%;
    height: 2;
    margin: 0;
    padding: 0 1;
    border: none;
    background: $background;
}

#crawler-filter-status,
#crawler-filter-serial,
#crawler-filter-file {
    width: 100%;
    height: 3;
    border: none;
    background: $background;
    padding: 0 1;
    margin-bottom: 1;
}

#crawler-filter-status RadioButton,
#crawler-filter-serial RadioButton,
#crawler-filter-file RadioButton {
    width: 100%;
    height: 1;
}

.crawler-filter-range {
    width: 100%;
    height: 3;
    align: center middle;
}

.crawler-filter-range Input {
    width: 1fr;
    height: 3;
    margin: 0 1;
}

#crawler-filter-buttons {
    width: 100%;
    height: 3;
    align: center middle;
}

#crawler-filter-buttons Button {
    min-width: 12;
    margin: 0 1;
}
