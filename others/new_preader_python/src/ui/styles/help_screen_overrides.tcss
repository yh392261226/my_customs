/* 帮助中心页面样式（参考 Textual 官方 home 示例：干净的中心面板 + 专注最大化） */

Header {
    dock: top;
    width: 100%;
    height: 1;
    text-align: left;
    color: $accent;
    background: $background;
    align: left middle;
    content-align: left middle;
}

Footer {
    height: 1;
    width: 100%;
    dock: bottom;
}

HelpScreen {
    layout: vertical;
    width: 100%;
    height: 100%;
    background: $background;
}

/* 顶部标题栏：呼应 home 示例的清爽标题条 */
#help-banner {
    width: 100%;
    height: 3;
    content-align: center middle;
    text-align: center;
    color: $text;
    text-style: bold;
    background: $panel-darken-1;
    border-bottom: solid $accent;
}

/* 主内容：标签式（TabbedContent）面板，卡片外观 */
#help-content {
    width: 100%;
    height: 1fr;
    padding: 0;
    border: round $primary;
    background: $surface;
    margin: 1 1;
}

/* 标签栏外观：显式尺寸，避免被压缩成 0 宽高导致不可见 / 不可点击 */
#help-content Tabs {
    width: 1fr;
    height: 3;
    padding: 0 1;
    background: $panel;
    border-bottom: solid $primary;
}

/* 单个标签：常态 / 悬停 / 选中（选中态高对比，明确指示当前页） */
#help-content Tabs Tab {
    color: $text-muted;
    padding: 0 2;
}

#help-content Tabs Tab:hover {
    color: $text;
    background: $primary 20%;
}

#help-content Tabs Tab.-active {
    color: $text;
    text-style: bold;
    background: $accent 30%;
}

/* 标签页面需填满内容区，否则内部 1fr 滚动容器无确定高度，导致 Collapsible 内容被压成 1 行 */
#help-content TabPane {
    height: 1fr;
}

/* 标签页面内分组容器（可滚动） */
.help-sections {
    height: 1fr;
    padding: 1 2;
}

/* 关键修复：common.tcss 全局 `Container { height: 100% }` 会覆盖 Collapsible 内置的
   `Contents { height: auto }`，导致可折叠内容高度塌陷、正文被裁掉。这里用更高优先级
   把 Collapsible 直接子容器（即 Contents）改回自适应高度。 */
#help-content Collapsible > Container {
    height: auto;
}

#help-content Collapsible Static {
    padding: 0 1;
    height: auto;
}

/* 底部操作栏 */
#help-controls {
    width: 100%;
    height: auto;
    background: $panel;
    border-top: solid $primary;
    padding: 1 1;
    align: center middle;
}

/* 返回按钮 */
#back-btn {
    width: auto;
    height: 3;
    min-width: 12;
}

/* 标签页面内 Static 正文（分组内容）配色：显式高对比，避免主题配色导致不可见 */
#help-content Static {
    padding: 1 2;
    color: $text;
    background: $surface;
}

/* 可折叠分组（标题含三角箭头，点击展开/收起）：显式文字/背景色 */
#help-content Collapsible {
    margin: 0 0 1 0;
    border: round $primary;
    background: $surface;
    color: $text;
}

#help-content Collapsible > CollapsibleTitle {
    color: $text;
    background: $surface;
    text-style: bold;
}
