/* PasswordDialog overrides - 保持原有尺寸与外观，按钮行由 .btn-row 管控 */

#password-dialog {
    width: 90%;
    height: 85%;
    background: $panel;
    border: round $primary;
    padding: 1;
    layout: vertical;
}

#password-title {
    width: 100%;
    height: 1;
    text-align: center;
    text-style: bold;
    margin-bottom: 1;
}

#password-filename {
    width: 100%;
    height: 1;
    text-align: center;
    margin-bottom: 1;
}

#password-input {
    width: 100%;
    height: 3;
    margin-bottom: 1;
}

#password-buttons {
    width: 100%;
    height: 3;
    /* 布局与对齐由 .btn-row 提供 */
}

#password-buttons > Button {
    margin: 0 1;
    min-width: 8;
}

/* 密码框切换按钮：固定宽度；纵向 margin 与密码输入框一致（上 0） */
.password-toggle {
    width: 5;
    min-width: 5;
    margin: 0 0 0 1;
}
/* 密码输入框与切换按钮同处一行，输入框吸收剩余空间（覆盖基础 100% 宽度） */
#password-field-row #password-input {
    width: 1fr;
}