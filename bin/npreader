#!/usr/bin/env bash

# python文件所在目录
LIBPATH=$MYRUNTIME/customs/others/new_preader_python
# 优先使用本项目自带的虚拟环境（Python 升级后系统 python 的依赖会失效）
PYBIN="$LIBPATH/venv/bin/python"
if [ ! -x "$PYBIN" ]; then
	PYBIN=/opt/homebrew/bin/python3
fi
TEXTUALBIN="$LIBPATH/venv/bin/textual"
if [ ! -x "$TEXTUALBIN" ]; then
	TEXTUALBIN=/opt/homebrew/bin/textual
fi

has_web=false
for arg in "$@"; do
	if [ "$arg" = "--web" ]; then
		has_web=true
		break
	fi
done

if $has_web; then
	echo "Web Mode Started. Enjoy!"
	open "http://localhost:8000"
fi
$PYBIN $LIBPATH/main.py "$@"
